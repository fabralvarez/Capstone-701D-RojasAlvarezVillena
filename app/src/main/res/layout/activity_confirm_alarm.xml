<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmAlarmActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/confirm_alarm_coordinator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/confirm_alarm_collapsing"
                style="?attr/collapsingToolbarLayoutMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
                android:background="?attr/colorSurface"
                app:contentScrim="?attr/colorSurface"
                app:expandedSubtitleTextAppearance="@style/TextAppearance.Material3.BodyMedium"
                app:expandedTitleGravity="bottom|center_horizontal"
                app:statusBarScrim="?attr/colorSurface">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/confirm_alarm_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/outline_arrow_back_24"
                    app:subtitle="@string/confirm_alarm_subtitle"
                    app:subtitleCentered="true"
                    app:title="@string/confirm_alarm_title"
                    app:titleCentered="true" />
            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/confirm_alarm_content"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirm_alarm_coordinator">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/confirm_alarm_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Paciente: Ana Díaz\nMedicamento: Paracetamol 500 mg" />

            <TextView
                android:id="@+id/confirm_alarm_selected_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/confirm_alarm_date_unset"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                tools:text="05/06/2024" />

            <TextView
                android:id="@+id/confirm_alarm_selected_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/confirm_alarm_time_unset"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                tools:text="07:30" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/confirm_alarm_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_pick_date"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_alarm_pick_date"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_pick_time"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/confirm_alarm_pick_time"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_alarm_continue"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:paddingHorizontal="60dp"
            android:paddingVertical="20dp"
            android:text="@string/add_alarm_continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="36dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
